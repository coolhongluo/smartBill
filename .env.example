# 本地环境变量模板
#
# 用法：
#   cp .env.example .env  然后填入真实值
#
# .env 已在 .gitignore 中，绝不会被提交。
# 生产环境的 Key 存在云函数环境变量里（dev / staging / prod 三套独立），
# 见技术文档 §8.1「密钥分层」。

# DeepSeek API Key
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 是否启用 LLM（应急降级开关：设为 false 全局转规则层）
# L2 规则降级即通过此开关触发，可行性专章 §4.3
LLM_ENABLED=true

# 单用户每日 Token 预算（成本熔断阈值）
TOKEN_DAILY_BUDGET=200000