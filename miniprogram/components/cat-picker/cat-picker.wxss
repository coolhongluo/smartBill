/* ── 类目选择器组件 ──
   样式从记账页搬来：选择器的视觉规格不因宿主页不同而改变，
   否则用户在记账页和编辑页会看到两种不同的选择器。 */

/* 遮罩与面板 */
.cat-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.cat-sheet {
  position: relative; /* 创建表单 overlay 的定位锚点 */
  width: 100%;
  height: 72vh;
  background: #FAF8F5;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  /* 底部留白：原生 tabBar 浮在页面之上，会盖住面板最后一行，
     导致最下面几个类目点不到、也拖不动 */
  padding: 32rpx 32rpx calc(110rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.cat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.cat-title { font-size: 32rpx; font-weight: 600; }
.cat-close { font-size: 34rpx; color: #CFC8C0; padding: 8rpx 16rpx; }

/* 搜索 */
.cat-search { margin-bottom: 20rpx; }
.cat-search-input {
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* 三级联动主体 */
.cat-body { flex: 1; display: flex; flex-direction: row; min-height: 0; }
.cat-lv1 {
  width: 220rpx;
  height: 100%;
  /* flex 子项默认 min-height:auto，不置 0 的话内容撑破容器，同样滚不动 */
  min-height: 0;
  background: #F2EFEA;
  border-radius: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.cat-lv1-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #7C6F64;
}
.cat-lv1-item.is-on {
  background: #FAF8F5;
  color: #3D3935;
  font-weight: 600;
}
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.cat-lv-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding-left: 20rpx;
}
/* 二级：flex 比例分配高度。
   原写法 max-height: 40% 在 flex 容器里百分比基准解析不可靠，
   scroll-view 拿到的高度不是确定值 → 内容溢出且滚不动。 */
.cat-lv2 {
  flex: 1 1 0;
  min-height: 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 分区小标题：二级/三级都是白底，没有标题会视觉混成一片 */
.cat-lv2-sec, .cat-lv3-sec {
  position: sticky;
  top: 0;
  padding: 14rpx 24rpx 10rpx;
  font-size: 21rpx;
  color: #B8B0A8;
  background: #FFFFFF;
  z-index: 2;
}
.cat-lv2-sec { border-top-left-radius: 20rpx; border-top-right-radius: 20rpx; }
.cat-lv3-sec { border-top-left-radius: 20rpx; border-top-right-radius: 20rpx; }

.cat-lv2-item {
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  color: #7C6F64;
  border-bottom: 1rpx solid #F5F2EE;
}
.cat-lv2-item.is-on {
  color: #3D3935;
  font-weight: 600;
  background: #F2EFEA;
}

/* 三级：与二级平分右侧空间 */
.cat-lv3 {
  flex: 1 1 0;
  min-height: 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}
.cat-lv3-item {
  padding: 24rpx;
  font-size: 28rpx;
  color: #3D3935;
  border-bottom: 1rpx solid #F5F2EE;
}
.cat-lv3-item:active { background: #F2EFEA; }
.cat-hint-col {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #C4BDB4;
}

/* 搜索结果 */
.cat-scroll { flex: 1; min-height: 0; }
.cat-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.cat-item-body { flex: 1; }
.cat-item-name { font-size: 29rpx; }
.cat-item-path { font-size: 22rpx; color: #B8B0A8; margin-top: 4rpx; }
.cat-empty, .cat-loading {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #A8A29E;
}

/* 搜索结果圆点 */
.cand-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* ── 自定义类目：常驻入口（创建表单在 components/cat-create 组件） ── */
.cat-footer {
  flex-shrink: 0;
  margin-top: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #7C6F64;
  background: #F2EFEA;
  border-radius: 999rpx;
}
/* 树内「自定义」角标：比候选卡片的角标更小，列表行高有限 */
.cat-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 0 10rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #A8A29E;
  background: #F2EFEA;
  border-radius: 999rpx;
  vertical-align: middle;
}
.cat-create-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 36rpx;
  font-size: 27rpx;
  color: #3D3935;
  background: #FFFFFF;
  border: 2rpx solid #D9CFC4;
  border-radius: 999rpx;
}
