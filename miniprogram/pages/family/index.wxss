page { background: #FAF8F5; color: #3D3935; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.card { background: #FFFFFF; border-radius: 28rpx; padding: 8rpx 32rpx; margin-bottom: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 600; padding: 28rpx 0 12rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #F5F2EE; font-size: 28rpx;
}
.val { color: #A8A29E; font-size: 25rpx; }
.val-mono { font-size: 28rpx; letter-spacing: 4rpx; color: #7C6F64; }
.diag-hint {
  padding: 8rpx 0 24rpx;
  font-size: 22rpx;
  color: #B8B0A8;
  line-height: 1.7;
}

/* ── 家庭概要 ── */
.family-name { font-size: 40rpx; font-weight: 600; padding: 8rpx 0 16rpx; }
.btn-row { display: flex; gap: 16rpx; padding-bottom: 24rpx; }

/* ── 成员列表 ── */
.member { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F5F2EE; }
.member:last-child { border-bottom: none; }
.member-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  flex-shrink: 0; display: block;
}
.member-avatar-empty {
  background: #F5F2EE; color: #A8A29E; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}
.member-info { flex: 1; margin-left: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.member-name { font-size: 28rpx; }
.member-badges { display: flex; gap: 8rpx; }
.badge {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
}
.badge-me { background: #EAF6F0; color: #2E7D5B; }
.badge-owner { background: #F5F2EE; color: #7C6F64; }

/* ── 输入与按钮 ── */
.input {
  font-size: 28rpx; color: #3D3935;
  border: 1rpx solid #EDE9E4; border-radius: 12rpx;
  padding: 20rpx 24rpx; margin: 8rpx 0 20rpx; background: #FAF8F5;
}
.btn {
  margin: 0 0 24rpx; border-radius: 999rpx;
  font-size: 28rpx; background: #FAF8F5; color: #3D3935;
}
.btn-primary { background: #7C6F64; color: #FFFFFF; }
.btn-danger { background: #FDECEC; color: #B93636; }
.btn::after { border: none; }
button[disabled].btn { background: #EDE9E4; color: #B8B0A8; }

.privacy {
  margin-top: 40rpx; padding: 0 16rpx;
  font-size: 22rpx; color: #B8B0A8; line-height: 1.8; text-align: center;
}
