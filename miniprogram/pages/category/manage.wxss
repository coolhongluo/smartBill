.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 概览统计 */
.stat-row { display: flex; margin-bottom: 24rpx; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 600; color: #3D3935; }
.stat-label { font-size: 22rpx; color: #A8A29E; margin-top: 4rpx; }

.persist-note {
  font-size: 24rpx;
  color: #A8A29E;
  line-height: 1.7;
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.btn-add {
  margin: 0;
  background: #3D3935;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  padding: 0;
}

/* 类目清单 */
.group { margin-bottom: 28rpx; }
.group:last-child { margin-bottom: 0; }
.group-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.group-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.group-title { font-size: 28rpx; font-weight: 600; color: #3D3935; }
.group-count { margin-left: auto; font-size: 22rpx; color: #A8A29E; }

.cat-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0 18rpx 28rpx;
  border-bottom: 1rpx solid #F5F1EC;
}
.cat-row:last-child { border-bottom: none; }
.cat-row-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cat-row-body { flex: 1; }
.cat-row-name { font-size: 28rpx; color: #3D3935; }
.cat-row-lv {
  display: inline-block;
  margin-left: 10rpx;
  padding: 0 10rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #A8A29E;
  background: #F2EFEA;
  border-radius: 999rpx;
  vertical-align: middle;
}
.cat-row-path { font-size: 22rpx; color: #B8B0A8; margin-top: 4rpx; }

.empty {
  font-size: 26rpx;
  color: #A8A29E;
  line-height: 1.8;
  text-align: center;
  padding: 40rpx 24rpx;
}
.loading {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #A8A29E;
}
