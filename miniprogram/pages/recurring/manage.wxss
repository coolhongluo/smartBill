page { background: #FAF8F5; color: #3D3935; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }

.loading, .empty { text-align: center; padding: 120rpx 0; color: #A8A29E; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #7C6F64; margin-bottom: 12rpx; }
.empty-sub { font-size: 24rpx; }

/* ── 规则卡片 ── */
.rule-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.rule-title { display: flex; align-items: center; }
.rule-amount {
  font-size: 36rpx; font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.rule-cat { font-size: 26rpx; color: #7C6F64; margin-left: 16rpx; }
.rule-ledger {
  font-size: 20rpx; color: #8A8580; background: #F1EEE9;
  padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 16rpx;
}
.rule-ledger.is-family { color: #3B6EA8; background: #E8F0FA; }
.rule-status {
  font-size: 20rpx; color: #3D9970; background: #EAF6EF;
  padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 16rpx;
}
.rule-status.is-paused { color: #A8A29E; background: #F1EEE9; }
.rule-repeat { font-size: 26rpx; color: #3D3935; margin-top: 12rpx; }
.rule-next { font-size: 22rpx; color: #A8A29E; margin-top: 8rpx; }
.rule-note { font-size: 22rpx; color: #C4BDB4; margin-top: 6rpx; }

.rule-actions {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F1EEE9;
}
.rule-btn {
  flex: 1;
  margin: 0 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  padding: 8rpx 0;
  color: #7C6F64;
  background: #FAF8F5;
  border-radius: 12rpx;
}
.rule-btn::after { border: none; }
.rule-btn:active { background: #F1EEE9; }
.rule-btn-danger { color: #A32D2D; background: #FBF1F1; }
.rule-btn-danger:active { background: #F5E3E3; }

/* ── 底部新建按钮 ── */
.add-btn {
  margin-top: 16rpx;
  width: 100%;
  color: #FFFFFF;
  background: #7C6F64;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.6;
  padding: 20rpx 0;
}
.add-btn::after { border: none; }
.add-btn:active { background: #625749; }

/* ══════════ 新建/编辑面板（样式与明细页编辑面板一致） ══════════ */
.edit-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.edit-sheet {
  width: 100%;
  max-height: 86vh;
  background: #FAF8F5;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 面板内容可能超过一屏：允许内部滚动 */
  overflow-y: auto;
}
.edit-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.edit-title { font-size: 32rpx; font-weight: 600; }
.edit-close { font-size: 34rpx; color: #CFC8C0; padding: 8rpx 16rpx; }

.edit-field { margin-bottom: 28rpx; }
.edit-label {
  display: block;
  font-size: 24rpx; color: #A8A29E;
  margin-bottom: 12rpx;
}

/* 金额：数字是大头，符号与输入框同一行 */
.edit-amount-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
}
.edit-yuan { font-size: 36rpx; color: #A8A29E; margin-right: 12rpx; }
.edit-amount {
  flex: 1;
  font-size: 44rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* 类目 / 重复方式 / 星期 / 日期：可点击的选择框 */
.edit-pick-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.edit-pick-text { font-size: 28rpx; color: #3D3935; }
.edit-pick-arrow { font-size: 32rpx; color: #CFC8C0; }

.edit-input {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
}
.edit-ph { color: #CFC8C0; }

/* 口径提示：随重复方式变化，说明「跳过/不补记」这类规则 */
.edit-hint {
  font-size: 22rpx; color: #B8B0A8;
  margin: -12rpx 8rpx 28rpx;
}

/* 底部操作：取消次要、保存主要 */
.edit-actions { display: flex; margin-top: 40rpx; }
.edit-btn {
  flex: 1;
  margin: 0 12rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.6;
  padding: 20rpx 0;
}
.edit-btn::after { border: none; }
.edit-btn-ghost {
  color: #7C6F64;
  background: transparent;
  border: 1rpx solid #E4DFD9;
}
.edit-btn-primary {
  color: #FFFFFF;
  background: #7C6F64;
  border: none;
}
.edit-btn-primary:active { background: #625749; }
.edit-btn-primary[disabled] { color: #C4BDB4; background: #F5F2EE; }
